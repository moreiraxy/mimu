{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'worker roda por tsx, sem build'",
    "watchPatterns": [
      "worker/**",
      "lib/**",
      "types/**",
      "package.json",
      "package-lock.json",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run whatsapp",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
