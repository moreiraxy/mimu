# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.development
# .env.production é versionado de propósito — só tem variáveis NEXT_PUBLIC_
# (públicas por design, acabam no bundle do navegador de qualquer forma),
# usado como fallback pra build da Vercel. Segredos nunca vão aqui.

# supabase
.branches
.temp
supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea

# claude code
.claude/

# Landing page compilada (site-mimo) copiada para cá pelo build.
# O fonte vive em site-mimo/; versionar a cópia duplicaria 36MB de imagem e
# criaria duas verdades sobre o que está no ar.
/public/assets/
/public/img/
/public/lp.html
/public/lp/
/public/fonts/marca/

# A sessão do WhatsApp — CREDENCIAL, nunca versionar.
#
# A pasta guarda as chaves que autenticam o número da Mimu no WhatsApp. Quem
# tiver esses arquivos assume a conta: lê as conversas e manda mensagem como se
# fosse a gente. Commitar isso é o mesmo que commitar uma senha, com o agravante
# de que revogar exige acesso físico ao celular do número.
.whatsapp-sessao/

# O worker empacotado. Gerado por `npm run build:worker` a cada deploy, como
# qualquer saída de build — versionar produziria conflito a cada mudança e
# permitiria subir um pacote velho sem ninguém notar.
/dist-worker/
