{
  "name": "mimu",
  "version": "0.1.0",
  "private": true,
  "description": "Mimu — PWA de gestão para microempreendedores brasileiros",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:lp && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:lp": "npm --prefix site-mimo ci && npm --prefix site-mimo run build && node scripts/copiar-lp.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "idb": "^8.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "mercadopago": "^3.3.0",
    "motion": "^13.0.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
