# Supabase
# Encontre esses valores em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role — apenas para uso em servidor (Route Handlers, Server Actions). Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (Llama)
# Gere em: https://console.groq.com/keys
GROQ_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Push notifications (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mercado Pago (assinatura)
# Encontre em: mercadopago.com.br → Seu negócio → Credenciais
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Definido em Suas integrações → Webhooks → Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Cakto (checkout externo)
# QUEM GERA ESTE VALOR É A CAKTO, não nós: ele nasce junto com o webhook e não
# aparece na API deles (a palavra "secret" não existe no contrato). Para
# descobrir: dispare um evento de teste e leia o campo `secret` do payload em
# webhook_event_history_list, ou copie do painel.
CAKTO_WEBHOOK_SECRET=

# Segredo de assinatura de JWT do projeto (Project Settings → API → JWT Secret).
#
# Necessário para a Mimu responder fora do app — hoje o WhatsApp. Com ele o
# servidor emite um token com a identidade de quem está falando, e o RLS
# continua valendo num canal que não tem login. Sem ele a única alternativa
# seria a service role, que ignora o RLS: o canal falha alto na subida em vez
# de atender com o isolamento desligado.
SUPABASE_JWT_SECRET=

# O número de WhatsApp da Mimu, com DDI e só dígitos (ex.: 5511999999999).
#
# É o número que o worker do WhatsApp pareia e para onde o botão "Conectar meu
# WhatsApp" manda a pessoa. Sem ele, a seção de conectar simplesmente não
# aparece no app — melhor não existir do que ser um botão que não leva a lugar
# nenhum.
NEXT_PUBLIC_WHATSAPP_MIMU=

# Senha da página que mostra o QR do WhatsApp (worker), em /parear?token=...
#
# Ler QR desenhado em log de painel é onde o pareamento costuma emperrar: o
# visualizador quebra as linhas e o código fica ilegível. Numa página HTML ele
# sempre escaneia.
#
# É credencial: quem lê aquele QR conecta o WhatsApp DELE ao nosso worker e
# passa a atender no lugar da Mimu. Sem esta variável a página não existe
# (404), e o pareamento continua possível pelo log.
WHATSAPP_QR_TOKEN=
