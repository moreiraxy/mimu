# Supabase
# Encontre esses valores em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role — apenas para uso em servidor (Route Handlers, Server Actions). Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude)
# Gere em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
