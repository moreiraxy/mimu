# Supabase
# Encontre esses valores em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role — apenas para uso em servidor (Route Handlers, Server Actions). Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (Llama)
# Gere em: https://console.groq.com/keys
GROQ_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Push notifications (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mercado Pago (assinatura)
# Encontre em: mercadopago.com.br → Seu negócio → Credenciais
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Definido em Suas integrações → Webhooks → Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=
